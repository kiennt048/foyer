# mods-available/always — generated by internal/raddb. Do not hand-edit.
#
# These are what make a bare `ok` or `reject` work as an unlang statement.
# FreeRADIUS has no built-in keyword for them: each is an rlm_always instance
# whose name is the return code, so writing `ok` in a virtual server is a module
# call that happens to look like a keyword.
#
# The whole set is emitted rather than the two currently used. A missing one
# fails at configuration-parse time with "Failed to find <code> as a module or
# policy", which reads like a typo and is not.
always reject {
	rcode = reject
}

always fail {
	rcode = fail
}

always ok {
	rcode = ok
}

always handled {
	rcode = handled
}

always invalid {
	rcode = invalid
}

always userlock {
	rcode = userlock
}

always notfound {
	rcode = notfound
}

always noop {
	rcode = noop
}

always updated {
	rcode = updated
}
