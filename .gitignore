# Build output
/dist/
/bin/
node_modules/
*.test

# Local environment — never commit secrets
.env
.env.*
!.env.example
*.pem
*.key
!**/testdata/**/*.pem
!**/testdata/**/*.key

# Local credentials for lab and test equipment. They may be KEPT locally so they
# need not be re-supplied each time; they must never be committed. These two
# lines are what makes that true.
/.secrets.local/
/.foyer/

# Generated FreeRADIUS config (built from the database at runtime)
/raddb/
/raddb.next/

# Local lab state
/lab/.state/
/lab/pgdata/
# The lab's own TLS material, copied into the generated tree by `make lab-raddb`
# so that everything mounting lab/raddb sees it. Generated, never committed —
# "never ship a CA" (docs/rules/security.md §7) applies to a repository at least
# as much as to an image.
/lab/raddb/certs/

# Editors / OS
.DS_Store
.idea/
.vscode/

# frontend
node_modules/
dist/
.ssr/

# The measurement probe (lab/measure). It is build output like `dist/`, and it
# is a *different* output: `lab/measure -probe` serves it to a phone, and
# nothing embeds it. Ignored for the ordinary reason — it is
# regenerated by `pnpm -F @foyer/portal build` and has no business in history —
# and for one that matters: a diagnostic document committed beside the guest
# bundle is a document somebody will eventually serve.
dist-probe/

# The frontends, embedded into the Go binary by `make web-embed`.
#
# `//go:embed` is a *compile-time* directive: a missing directory is a build error,
# not a runtime absence. So each of these carries one committed `.gitkeep` and
# nothing else — that is what keeps `go build ./...` working on a fresh clone and in
# a CI job that never runs `pnpm build`. `internal/webui/webui.go` has the reasoning,
# and `webui.Built()` is what a binary with an empty tree reports.
#
# A sync into these must delete before it copies, or a stale content-hashed asset
# stays embedded: `rsync -a --delete --exclude '.gitkeep'`.
/internal/webui/portal-dist/*
!/internal/webui/portal-dist/.gitkeep
/internal/webui/admin-dist/*
!/internal/webui/admin-dist/.gitkeep

# `go build ./cmd/foyer/` and `./cmd/foyerctl/` write their binaries here (24 MB
# each, and easy to commit by accident). The build outputs are named after their
# packages, so the rules are anchored to the repository root: `internal/foyer/`
# would otherwise be swept up by a bare `foyer`.
/foyer
/foyerctl

# Python bytecode
__pycache__/
*.pyc
