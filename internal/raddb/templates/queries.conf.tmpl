# PostgreSQL queries for FreeRADIUS 3.2.x — generated by internal/raddb.
# INVARIANT: post-auth query MUST NEVER insert into 'pass' column!
# INVARIANT: post-auth query MUST populate CalledStationId and CallingStationId.

#######################################################################
#  Client query — read_clients = yes
#######################################################################
#  rlm_sql maps the columns positionally and reads exactly six:
#
#    0. row id (unused)      3. type
#    1. nasname (IP)         4. secret
#    2. shortname            5. virtual server
#
#  There is no seventh column, so require_message_authenticator cannot be
#  carried per client here. It is set globally in radiusd.conf's security {}
#  section and again per discovered client in sites-available/dynamic-clients.
#
#  This query runs once, at startup. A row added later is found by the
#  dynamic-clients virtual server instead.
client_query = "SELECT id, nasname, shortname, type, secret, server FROM {{.ClientTable}}"

accounting {
    reference = "%{tolower:type.%{Acct-Status-Type}.query}"
    type {
        accounting-on {
            query = "UPDATE radacct \
                SET \
                    acctstoptime = NOW(), \
                    acctsessiontime = EXTRACT(EPOCH FROM (NOW() - acctstarttime))::bigint, \
                    acctterminatecause = 'NAS-Reboot' \
                WHERE acctstoptime IS NULL \
                AND nasipaddress = '%{NAS-IP-Address}' \
                AND acctstarttime <= NOW()"
        }

        accounting-off {
            query = "UPDATE radacct \
                SET \
                    acctstoptime = NOW(), \
                    acctsessiontime = EXTRACT(EPOCH FROM (NOW() - acctstarttime))::bigint, \
                    acctterminatecause = 'NAS-Reboot' \
                WHERE acctstoptime IS NULL \
                AND nasipaddress = '%{NAS-IP-Address}' \
                AND acctstarttime <= NOW()"
        }

        start {
            query = "INSERT INTO radacct ( \
                acctsessionid, acctuniqueid, username, realm, \
                nasipaddress, nasportid, nasporttype, \
                acctstarttime, acctupdatetime, \
                acctauthentic, connectinfo_start, \
                calledstationid, callingstationid, \
                servicetype, framedprotocol, framedipaddress, class \
            ) VALUES ( \
                '%{Acct-Session-Id}', '%{Acct-Unique-Session-Id}', '%{User-Name}', '%{Realm}', \
                '%{NAS-IP-Address}', '%{NAS-Port-Id}', '%{NAS-Port-Type}', \
                NOW(), NOW(), \
                '%{Acct-Authentic}', '%{Connect-Info}', \
                '%{Called-Station-Id}', '%{Calling-Station-Id}', \
                '%{Service-Type}', '%{Framed-Protocol}', NULLIF('%{Framed-IP-Address}','')::inet, '%{Class}' \
            )"
        }

        interim-update {
            query = "UPDATE radacct \
                SET \
                    acctupdatetime = NOW(), \
                    acctinterval = NULLIF('%{Acct-Interim-Interval}','')::bigint, \
                    acctsessiontime = NULLIF('%{Acct-Session-Time}','')::bigint, \
                    acctinputoctets = (COALESCE(NULLIF('%{Acct-Input-Gigawords}','')::bigint, 0) << 32) | COALESCE(NULLIF('%{Acct-Input-Octets}','')::bigint, 0), \
                    acctoutputoctets = (COALESCE(NULLIF('%{Acct-Output-Gigawords}','')::bigint, 0) << 32) | COALESCE(NULLIF('%{Acct-Output-Octets}','')::bigint, 0), \
                    framedipaddress = NULLIF('%{Framed-IP-Address}','')::inet \
                WHERE acctuniqueid = '%{Acct-Unique-Session-Id}'"
        }

        stop {
            query = "UPDATE radacct \
                SET \
                    acctstoptime = NOW(), \
                    acctsessiontime = NULLIF('%{Acct-Session-Time}','')::bigint, \
                    acctinputoctets = (COALESCE(NULLIF('%{Acct-Input-Gigawords}','')::bigint, 0) << 32) | COALESCE(NULLIF('%{Acct-Input-Octets}','')::bigint, 0), \
                    acctoutputoctets = (COALESCE(NULLIF('%{Acct-Output-Gigawords}','')::bigint, 0) << 32) | COALESCE(NULLIF('%{Acct-Output-Octets}','')::bigint, 0), \
                    acctterminatecause = '%{Acct-Terminate-Cause}', \
                    framedipaddress = NULLIF('%{Framed-IP-Address}','')::inet \
                WHERE acctuniqueid = '%{Acct-Unique-Session-Id}'"
        }
    }
}

#######################################################################
#  post-auth — the authentication ledger the admin console reads
#######################################################################
#  `username` is the identity EAP PROVED where there is one, and the packet's
#  User-Name otherwise.
#
#  Not simply %{User-Name}, and this is measured rather than fastidious. On any
#  EAP method the outer User-Name is chosen by the supplicant and checked against
#  nothing — that is what it is for. Measured on 3.2.10: a supplicant
#  presenting the client certificate for one account while sending the User-Name
#  of ANOTHER REAL ACCOUNT authenticated correctly and the outer server logged
#  the second name. Writing that into this table would make every 802.1X row an
#  attacker-controlled audit record — the shape of security.md §4's unsigned NAS
#  redirect parameters, one layer down, in the one table an operator turns to
#  when somebody asks who got on the network.
#
#  Tmp-String-2 is set in sites-available/default's post-auth, from
#  &TLS-Client-Cert-Common-Name. `%{%{a}:-%{b}}` is FreeRADIUS's "or else": it is
#  unset on every non-EAP request, and this falls back to User-Name there.
post-auth {
    query = "INSERT INTO radpostauth ( \
        username, reply, authdate, calledstationid, callingstationid, class \
    ) VALUES ( \
        '%{%{Tmp-String-2}:-%{User-Name}}', '%{reply:Packet-Type}', NOW(), \
        '%{Called-Station-Id}', '%{Calling-Station-Id}', '%{reply:Class}' \
    )"
}
