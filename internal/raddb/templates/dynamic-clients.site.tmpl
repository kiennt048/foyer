# sites-available/dynamic-clients — generated by internal/raddb. Do not hand-edit.
#
# This virtual server answers one question: "a packet arrived from an address
# inside one of the networks in clients.conf — is there a client row for it?"
#
# The request passed in here is empty. The only usable input is
# Packet-Src-IP-Address. Returning anything other than "ok" means the address is
# not a client and the packet is discarded, which is the correct answer for an
# address Foyer has never been told about.
server foyer_dynamic_clients {
	authorize {
		if ("%{sql:SELECT nasname FROM {{.ClientTable}} WHERE nasname = '%{Packet-Src-IP-Address}'}") {
			update control {
				&FreeRADIUS-Client-IP-Address = "%{Packet-Src-IP-Address}"
				&FreeRADIUS-Client-Shortname = "%{sql:SELECT shortname FROM {{.ClientTable}} WHERE nasname = '%{Packet-Src-IP-Address}'}"
				&FreeRADIUS-Client-Secret = "%{sql:SELECT secret FROM {{.ClientTable}} WHERE nasname = '%{Packet-Src-IP-Address}'}"
				&FreeRADIUS-Client-NAS-Type = "%{sql:SELECT type FROM {{.ClientTable}} WHERE nasname = '%{Packet-Src-IP-Address}'}"

				# Not inherited from the network section and not defaulted:
				# stated per client, every client, always yes.
				&FreeRADIUS-Client-Require-MA = yes
			}
			ok
		}
		else {
			reject
		}
	}
}
