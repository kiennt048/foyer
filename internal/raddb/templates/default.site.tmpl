# sites-available/default — generated by internal/raddb. Do not hand-edit.
server default {
	listen {
		type = auth
		ipaddr = {{.ListenIP}}
		port = {{.AuthPort}}
	}

	listen {
		type = acct
		ipaddr = {{.ListenIP}}
		port = {{.AcctPort}}
	}

	authorize {
		preprocess
{{if .EAP.Enabled}}
		#  EAP owns the authentication conversation, and nothing below may
		#  overwrite the Auth-Type it sets. The policy engine answers
		#  authorization, which is a different question from whether the
		#  supplicant proved possession of a key.
		#
		#  Both return codes return, and the second is the one that matters:
		#  rlm_eap answers `updated` for the packet where it sets Auth-Type and
		#  `ok` for the continuation packets. Returning on `ok` alone — which is
		#  what the stock configuration does, because it has a user lookup to
		#  fall through to — would let the module below overwrite Auth-Type on
		#  the first packet of every conversation.
		eap {
			ok = return
			updated = return
		}
{{end}}
		#  Authorization decision from the Go control plane. rlm_rest carries
		#  decisions only: it never returns credential material, because a
		#  Policy API that yields a verifier for any username supplied is a
		#  credential-store dump that never touches Postgres.
		#  802.1X is exactly "the request carries EAP", and that is the whole
		#  of the test. Not a Service-Type heuristic: Service-Type is
		#  NAS-supplied, varies by vendor, and is absent more often than not.
		#
		#  Tmp-String-0 is internal and never reaches the wire. The Policy API
		#  is told that EAP is present, never what the EAP said.
		if (&EAP-Message) {
			update request {
				Tmp-String-0 := "present"
			}
		}

		#  Every return code is given an action, and the action is always
		#  "carry on to the next statement".
		#
		#  Without this the section ends at the module. rlm_rest answers
		#  `userlock` for the HTTP 403 the policy engine returns for a denial,
		#  and unlang's default action for `userlock` in authorize is to return
		#  immediately — so the branches below never ran on the deny path, and
		#  the Access-Reject came from the default action rather than from
		#  anything written here. Measured in the lab: the trace
		#  read `[rest] = userlock` and the section ended on that line.
		rest {
			ok = 1
			updated = 1
			noop = 1
			notfound = 1
			reject = 1
			userlock = 1
			invalid = 1
			fail = 1
		}
		if (ok || updated) {
			#  The Policy API AUTHORIZED. Whether anything has been
			#  AUTHENTICATED depends on what it authorized, and it says which in
			#  Foyer-Identity-Kind -- an internal attribute (dictionary, 3000)
			#  that rlm_rest puts in the reply list and no packet ever carries.
			#
			#  If this branch were `Auth-Type := Accept` and nothing else, for
			#  every allow, a guest account's USERNAME would be enough to get on,
			#  because no password would reach any check. So:
			#
			#    voucher  the code is the bearer credential and the Policy API
			#             just claimed it (single use, as the portal does), so
			#             there is nothing further to prove. Accept.
			#    account  a username is not a secret. rlm_pap checks User-Password
			#             against the bcrypt verifier this server reads ITSELF,
			#             through rlm_sql, from radius_pap_verifiers -- the
			#             two-column view foyer_radius may read without a tenant
			#             GUC, which lists opted-in, ENABLED accounts only. No
			#             verifier, or no User-Password (CHAP, say), is a refusal:
			#             this server cannot check a password it cannot verify,
			#             and argon2id is not a scheme rlm_pap has (measured).
			#    anything else, including no kind at all -- a Policy API older
			#             than this attribute -- is a refusal. An allow that does
			#             not say what it allowed is not one this server can act on.
			#
			#  The verifier is fetched with the sql xlat, and the User-Name goes
			#  into the query as HEX, decoded by PostgreSQL. The sql xlat escapes
			#  what it splices with rlm_sql's safe_characters, rewriting anything
			#  else as =XX -- so a name with a quote, or on the NetworkRADIUS
			#  build a name like `nguyễn`, spliced in directly would be looked up
			#  as a DIFFERENT string: the right password refused, and `o'brien`
			#  checked against the verifier of an account literally named
			#  `o=27brien`, if one existed (measured on 3.2.10). Hex is all
			#  safe characters, so the escape is the identity, the string
			#  PostgreSQL compares is the one the NAS sent, and nothing the client
			#  chose can reach the SQL text. A name that is not UTF-8 never gets
			#  here (internal/aaa refuses it), and if it did convert_from would
			#  fail, the verifier would be empty, and the shape check refuses.
			#
			#  It is shape-checked before rlm_pap sees it: Crypt-Password only, never
			#  the {header}-parsing attribute, which rlm_pap turns into the
			#  known-good plaintext password when it finds no header (measured on
			#  3.2.10).
			if (&reply:Foyer-Identity-Kind == "voucher") {
				update control {
					Auth-Type := Accept
				}
			}
			elsif ((&reply:Foyer-Identity-Kind == "account") && &User-Password) {
				update control {
					&Crypt-Password := "%{sql:SELECT verifier FROM radius_pap_verifiers WHERE username = convert_from(decode('%{hex:&User-Name}', 'hex'), 'UTF8')}"
				}
				if (&control:Crypt-Password =~ /^\$2[ab]\$[0-9]{2}\$[.\/A-Za-z0-9]{53}$/) {
					update control {
						Auth-Type := PAP
					}
				}
				else {
					update control {
						&Crypt-Password !* ANY
					}
					update reply {
						Reply-Message := "denied by policy"
					}
					update control {
						Auth-Type := Reject
					}
				}
			}
			else {
				update reply {
					Reply-Message := "denied by policy"
				}
				update control {
					Auth-Type := Reject
				}
			}
			update reply {
				&Foyer-Identity-Kind !* ANY
			}
		}
		elsif (fail) {
			#  The policy engine did not answer: rlm_rest could not connect, timed
			#  out, or got a 5xx (measured on 3.2.10: 500 and 503 map
			#  to `fail`).
			#
			#  `invalid` is NOT here. It is what rlm_rest answers for a 4xx
			#  other than 401/403/404 -- measured, 400 and 422 both -- and the
			#  Policy API answers 400 when it cannot read the question. The
			#  question is built from values the CLIENT chose, and one control
			#  byte in a User-Name makes it unreadable: were `invalid` here, the
			#  client would pick the failure branch, and at a fail-open site that
			#  is an accept. An unreadable question is refused, below.
			#
			#  A denial arrives as `userlock` instead, because that is what
			#  rlm_rest maps HTTP 403 to. It is handled below too.
			if (&EAP-Message) {
				#  802.1X fails closed, whatever the site is configured for.
				#  There is no such thing as a degraded 802.1X accept: the
				#  supplicant expects keying material this server cannot invent.
				update reply {
					Reply-Message := "policy engine unavailable"
				}
				update control {
					Auth-Type := Reject
				}
			}
			else {
				#  Guest, and this is the half the operator gets a say in.
				#  Resolved at GENERATION time, never here: by the time this
				#  branch runs, the thing that would resolve a rule is the thing
				#  that is down.
				#
				#  {{.GuestFailureSummary}}
{{- if .GuestFailsOpen}}
				#
				#  FAIL-OPEN. The reply carries how long, how often to report,
				#  and a mark saying this was not a decision -- and nothing
				#  else. Every other attribute the Policy API would have
				#  supplied (a rate limit from the voucher batch, a VLAN from
				#  the account, a real Session-Timeout) is a value that had to be
				#  looked up, and the lookup is exactly what is unavailable.
				#  Emitting a remembered or guessed one is worse than emitting
				#  none: it is the admin console's rate-limit field silently not
				#  applying.
				#
				#  Class is echoed unmodified by the NAS in its accounting
				#  packets (RFC 2865 §5.25), so the sessions a site let on while
				#  blind are identifiable in radacct afterwards rather than
				#  indistinguishable from authorized ones. DOCUMENTED from the
				#  RFC, not measured against any NAS.
				#
				#  Session-Timeout is what makes this bounded: the device
				#  re-authenticates when it expires, so the moment the Policy API
				#  is back the next re-authentication is a real decision rather
				#  than another free pass. A blip of thirty seconds must not mint
				#  an eight-hour session.
				update reply {
{{- range .GuestGraceAttributes}}
					{{.}}
{{- end}}
				}
				update control {
					Auth-Type := Accept
				}
{{- else}}
				update reply {
					Reply-Message := "policy engine unavailable"
				}
				update control {
					Auth-Type := Reject
				}
{{- end}}
			}
		}
		else {
			#  The policy engine answered, and the answer was no. Measured:
			#  a denial arrives here as `userlock`, because that is what
			#  rlm_rest maps HTTP 403 to. `invalid` -- a question the Policy API
			#  could not read -- lands here too, deliberately; see above.
			#
			#  Distinct from the branch above on purpose: from outside, a denial
			#  and an unreachable control plane are the same Access-Reject, and
			#  telling them apart is the difference between a wrong voucher and
			#  an outage.
			update reply {
				Reply-Message := "denied by policy"
			}
			update control {
				Auth-Type := Reject
			}
		}

		#  Many NAS send no interim updates unless the server asks, and on the
		#  controller-API path there is no Access-Accept to ask in at all.
		update reply {
			Acct-Interim-Interval := {{.DefaultInterimIntervalSeconds}}
		}
	}

	authenticate {
		Auth-Type PAP {
			pap
		}
		Auth-Type REST {
			rest
		}
{{- if .EAP.Enabled}}
		#  Bare, not wrapped in an Auth-Type section: a module named at the top
		#  level of authenticate is run when Auth-Type matches its instance
		#  name, and rlm_eap sets Auth-Type to its own instance name.
		eap
{{- end}}
	}

	preacct {
		preprocess

		#  Acct-Unique-Session-Id, which radacct.acctuniqueid is keyed on
		#  (NOT NULL UNIQUE) and every interim-update and stop is matched by.
		#
		#  FreeRADIUS 3 does not compute it by itself -- rlm_acct_unique became
		#  the `acct_unique` policy in policy.d, and this generated tree has no
		#  policy.d -- so without this it expands to the empty string: the
		#  first session's start inserts acctuniqueid = '', the second
		#  concurrent session's start collides with it, and every interim and
		#  stop updates whichever row holds ''. This is the stock policy's
		#  fallback hash, inlined, over the fields a NAS keeps for the life of a
		#  session.
		update request {
			&Acct-Unique-Session-Id := "%{md5:%{User-Name},%{Acct-Session-ID},%{%{NAS-IPv6-Address}:-%{NAS-IP-Address}},%{NAS-Identifier},%{NAS-Port-ID},%{NAS-Port}}"
		}
	}

	accounting {
		sql
	}

	post-auth {
		update {
			&reply: += &session-state:
		}
{{- if .EAP.Enabled}}

		#  ── the identity EAP proved, as opposed to the one it was told ──────
		#
		#  For EAP-TLS that is the client certificate's Common Name.
		#  &TLS-Client-Cert-Common-Name is put in the request list by rlm_eap_tls
		#  while the handshake runs, and it is still there in post-auth of the
		#  final packet — measured on 3.2.10.
		#
		#  &User-Name is not it. A supplicant sends whatever it likes there, and
		#  a run with the certificate for one account and the User-Name of
		#  another authenticated and logged the second. security.md §8 calls that
		#  letting an attacker choose their own authorization subject; it is
		#  usually described for PEAP and TTLS, and it is true of EAP-TLS today.
		#
		#  Tmp-String-2 rather than Tmp-String-0: that one already carries the
		#  EAP presence marker set in authorize, and reusing it would be a
		#  collision that shows up only under EAP.
		if (&TLS-Client-Cert-Common-Name) {
			update request {
				Tmp-String-2 := "%{TLS-Client-Cert-Common-Name}"
			}
		}

		#  Authorization, on the EAP path.
		#
		#  `eap` returns from authorize before `rest` runs, so without this block
		#  no EAP request would be put to the policy engine: every certificate
		#  the configured CA had signed would be accepted, permanently, whatever
		#  the control plane thought of the identity.
		#
		#  Every return code is given an action for the same reason the authorize
		#  section gives them: rlm_rest maps the policy engine's HTTP 403 to
		#  `userlock`, whose default action is to return from the section, so the
		#  branches below would never run on a denial.
		if (&Tmp-String-2) {
			rest {
				ok = 1
				updated = 1
				noop = 1
				notfound = 1
				reject = 1
				userlock = 1
				invalid = 1
				fail = 1
			}
			if (!ok && !updated) {
				#  Denied, or unanswered. Both close: this is 802.1X by
				#  construction — the request carried EAP — and 802.1X fails
				#  closed whatever the site is configured for. There is no
				#  degraded 802.1X accept, because the supplicant expects
				#  keying material this server cannot invent.
				#
				#  The reply built on the way here has to be torn down, and that
				#  is not tidiness. Measured: without this the
				#  Access-Reject still carried the EAP-Success and both
				#  MS-MPPE keys, so the supplicant reported
				#  CTRL-EVENT-EAP-SUCCESS for a session the NAS had refused, and
				#  session keying material travelled in a packet that must carry
				#  none.
				update reply {
					EAP-Message !* ANY
					MS-MPPE-Recv-Key !* ANY
					MS-MPPE-Send-Key !* ANY
					Reply-Message := "denied by policy"
				}
				reject
			}

			#  The kind is an authorize-time instruction and means nothing here:
			#  EAP has already proven the identity. Removed AFTER the rcode test
			#  above, not before it -- an `update` is a statement with an rcode of
			#  its own (noop), and placed between `rest` and `if (!ok &&
			#  !updated)` it makes every EAP accept a reject. Measured in lab/eap
			#  on 3.2.10.
			update reply {
				&Foyer-Identity-Kind !* ANY
			}
		}

		#  The EAP path returns from authorize before the interim interval is
		#  set there. Many NAS send no interim updates unless the server asks,
		#  so it is asked for again here, where every accepted request passes.
		update reply {
			Acct-Interim-Interval := {{.DefaultInterimIntervalSeconds}}
		}
{{- end}}
		sql

		Post-Auth-Type REJECT {
			sql

			#  An Access-Reject carries a reason and nothing else.
			#
			#  FreeRADIUS does not strip the reply list on a reject, and the
			#  account path makes that visible: the Policy API's allow puts
			#  Session-Timeout, the rate limit and the rest into the reply BEFORE
			#  rlm_pap refuses the password, and measured on 3.2.10 an unstripped
			#  Access-Reject for a wrong password carries them. That tells
			#  whoever reads the reply -- a hotspot login page shows it to the
			#  guest -- that the username is a real account with
			#  a real plan. RFC 2865 §5.44 allows none of them in a reject.
			#
			#  So the reply is emptied, and one Reply-Message is put back: the one
			#  a branch above set, or "denied by policy" for a reject that set
			#  none (a wrong password). The same words as an unknown identity, on
			#  purpose. Logged by `sql` above first, so radpostauth is unchanged.
			if (&reply:Reply-Message) {
				update request {
					&Tmp-String-5 := &reply:Reply-Message
				}
			}
			else {
				update request {
					&Tmp-String-5 := "denied by policy"
				}
			}
			update {
				&reply: !* ANY
			}
			update reply {
				&Reply-Message := &request:Tmp-String-5
			}
{{- if .EAP.Enabled}}
			eap
{{- end}}
		}
	}
}
