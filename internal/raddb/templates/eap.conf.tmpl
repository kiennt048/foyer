# mods-available/eap — generated by internal/raddb. Do not hand-edit.
#
# Emitted only when EAP is enabled. One method is configured: EAP-TLS.
#
# EAP-TLS is first because it is the only method that requires the server to
# hold no recoverable credential material at all. Every other method this
# project will support forces a decision about credential storage, and those
# decisions belong with the schema that carries them.
#
# It is the only one, and that is a measurement rather than a plan.
# Measured on this exact server version:
# rlm_pap implements no argon2 scheme and cannot reach one through crypt(3)
# either, so EAP-TTLS/PAP has nothing to verify against; and MSCHAPv2 needs the
# NT hash in the clear at request time, which Foyer's schema deliberately cannot
# produce. `Generator.Validate` refuses `ttls` and `peap` by name and says so.
#
# The certificate, key and CA are paths, never contents. Nothing here generates
# a certificate and no image ships one: a fixed key means every deployment on
# earth shares one private key.
eap {
	default_eap_type = {{.EAP.DefaultEAPType}}
	timer_expire = 60
	ignore_unknown_eap_types = no
	max_sessions = 4096

	tls-config tls-common {
		certificate_file = {{.EAP.ServerCertFile}}
		private_key_file = {{.EAP.PrivateKeyFile}}
		ca_file = {{.EAP.CAFile}}
{{- if .EAP.DHFile}}
		dh_file = {{.EAP.DHFile}}
{{- end}}

		tls_min_version = "1.2"
		tls_max_version = "1.3"

{{- if .EAP.TLSSessionCacheDir}}
		#
		#  The TLS session cache is ON and persisted to disk.
		#
		#  `docs/rules/radius.md` wants this cache to survive a restart,
		#  because a restart otherwise costs every corporate laptop on site a
		#  full re-authentication. It asks for Redis. **There is no Redis
		#  backend for this cache in 3.2.x** — it is internal to rlm_eap_tls,
		#  not an rlm_cache instance, and a Redis server item written in here
		#  is discarded without a warning while `radiusd -XC` still exits 0.
		#  Measured; `persist_dir` is the mechanism that exists and
		#  it does what the rule asks for.
		#
		#  Two costs, both real, both the reason this is off unless asked for:
		#
		#    * A resumed session SKIPS the inner method. A cached entry
		#      re-admits a supplicant without the certificate being presented
		#      again — which is what resumption is, and is why FreeRADIUS ships
		#      this disabled.
		#    * This directory holds the TLS master secret (<id>.asn1) beside
		#      the cached attributes (<id>.vps). It is key material. 0700, owned
		#      by the server user, and never in a support bundle.
		#
		cache {
			enable = yes
			name = "foyer"
			lifetime = 24
			max_entries = 4096
			persist_dir = "{{.EAP.TLSSessionCacheDir}}"
		}
{{- else}}
		#
		#  The TLS session cache is off.
		#
		#  Two reasons, and only the first is a preference. A cache lets a
		#  supplicant resume rather than complete a handshake, so the EAP
		#  case in gate 3 would stop testing the thing it exists to test.
		#
		#  The second is a cost: every reconnect pays a full handshake, and
		#  that price is real the day a supplicant uses EAP, which is the day
		#  anyone turns this module on. Set `EAP.TLSSessionCacheDir` and the cache is
		#  persisted to disk — `persist_dir`, not Redis, because 3.2.x has no
		#  Redis backend for this cache at all. Measured; the two costs of
		#  enabling it are stated above.
		#
		cache {
			enable = no
		}
{{- end}}

		verify {
		}
	}

	tls {
		tls = tls-common
	}
}
